# Copy this file to `.env` in the project folder and fill in your keys. `.env` is git-ignored; never commit it.
# Real environment variables of the same name take precedence over this file. PIA never prints a key.

# Required for every run that writes a briefing (the editor stage, and the triage stage when Jev is not used).
# Free tier keys: https://console.groq.com
GROQ_API_KEY=

# Optional: enables Jev (a hosted decision model from TypeSafe) as Stage 1 triage. Without it PIA uses the
# Groq LLM triage instead. Jev additionally needs your interest profile: copy config/interests.example.toml
# to config/interests.toml and edit it. (JEV_API_KEY is accepted as an alias for TYPESAFE_API_KEY.)
TYPESAFE_API_KEY=

# Optional: pin a Jev version so results stay comparable over time (default: the alias `jev-latest`, which moves).
# JEV_MODEL=jev-1.13.0

# Optional: which Stage 1 to use: auto (Jev if a key and a profile exist, otherwise the LLM), jev (strict) or llm.
# Also available as `pia --triage ...`.
# PIA_TRIAGE=auto
