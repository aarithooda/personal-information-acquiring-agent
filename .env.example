# Copy this file to `.env` in the project folder and fill in what you use. `.env` is git-ignored; never commit it.
# Real environment variables of the same name take precedence over this file. PIA never prints a key.
# Every key here is optional: with none, PIA still acquires, classifies, ranks and links items.

# Summaries, briefs, opportunity details and source evaluation (Groq). Free tier keys: https://console.groq.com
GROQ_API_KEY=

# NOT USED by default. Groq is the only external model provider. Jev (a hosted decision model from TypeSafe) is
# integrated but dormant: a key here does nothing unless config/models.toml also sets `jev = true` under
# [providers] (and config/interests.toml exists). JEV_API_KEY is accepted as an alias for TYPESAFE_API_KEY.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.14.0

# Optional: read-only Gmail for university announcements. See docs/platform/GMAIL.md before setting these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Running PIA where other machines can reach it (see docs/platform/OPERATIONS.md) ---
# PIA_PASSWORD=            # required for any non-local address; or use `pia set-password`
# PIA_HOST=0.0.0.0
# PORT=8765
# PIA_ALLOWED_HOSTS=pia.example.org
# PIA_DATA=data/platform.db
# PIA_NO_MODELS=1          # deterministic processing only: call no model at all

# --- v1 briefing pipeline only ---
# Which Stage 1 the v1 `pia` command uses: llm (Groq, the default), jev, or auto (Jev if a key and a profile exist).
# PIA_TRIAGE=llm
