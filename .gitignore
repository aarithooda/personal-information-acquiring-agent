data/
*.db
*.db-*
*.sqlite
*.sqlite3
briefings/

# Local tool and editor configuration
.claude/
.vscode/
.idea/

# Build output
build/
dist/

# Personal interest profile (describes the user). config/interests.example.toml is the committed template.
config/interests.toml

# Benchmark: the item snapshot, your labels and the arm results describe your reading habits. Code and docs are committed.
benchmarks/data/

# Benchmark v2: the corpus, labels, arms and reports describe the reader's habits and opinions. Code and the methodology are committed.
benchmark_v2/data/
